{
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "framework": "nextjs",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "regions": ["fra1"],
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "build": {
    "env": {
      "NEXT_PUBLIC_MINIO_ENDPOINT": "@minio-endpoint",
      "NEXT_PUBLIC_MINIO_BUCKET": "@minio-bucket"
    }
  }
}
