# 10) Mini-Snippets (damit Cursor weiß, wie’s aussehen soll)

**`lib/s3.ts`**

```ts
import { S3Client } from "@aws-sdk/client-s3";

export const getS3 = () =>
  new S3Client({
    region: process.env.MINIO_REGION!,
    endpoint: process.env.MINIO_ENDPOINT!,
    credentials: {
      accessKeyId: process.env.MINIO_ACCESS_KEY!,
      secretAccessKey: process.env.MINIO_SECRET_KEY!,
    },
    forcePathStyle: true,
  });

export const objectKey = (ext: string) => {
  const eventId = process.env.EVENT_CODE ?? "event";
  const d = new Date();
  const yyyy = d.getFullYear();
  const mm = String(d.getMonth() + 1).padStart(2, "0");
  const dd = String(d.getDate()).padStart(2, "0");
  return `${eventId}/${yyyy}-${mm}-${dd}/${crypto.randomUUID()}.${ext}`;
};
```

**`app/api/upload/route.ts` (Skizze)**

```ts
import { NextRequest } from "next/server";
import { getS3, objectKey } from "@/lib/s3";
import { PutObjectCommand } from "@aws-sdk/client-s3";
import { getSignedUrl } from "@aws-sdk/s3-request-presigner";

export async function POST(req: NextRequest) {
  const { filename, contentType, size } = await req.json();
  const max = Number(process.env.UPLOAD_MAX_MB ?? 25) * 1024 * 1024;
  const allow = (process.env.UPLOAD_ALLOWED_MIME ?? "image/jpeg,image/png,image/heic,image/heif")
    .split(",")
    .map(s => s.trim());

  if (!contentType || !allow.includes(contentType)) {
    return Response.json({ error: "Unsupported MIME" }, { status: 415 });
  }
  if (!size || size > max) {
    return Response.json({ error: "File too large" }, { status: 413 });
  }

  const ext = (filename?.split(".").pop() ?? "jpg").toLowerCase();
  const Key = objectKey(ext);
  const Bucket = process.env.MINIO_BUCKET!;
  const s3 = getS3();

  const cmd = new PutObjectCommand({ Bucket, Key, ContentType: contentType });
  const url = await getSignedUrl(s3, cmd, { expiresIn: 60 * 5 });

  return Response.json({ url, key: Key });
}
```

